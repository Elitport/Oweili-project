# =====================================================================
#  Oweili — keep private project files off the public website.
#  Anything blocked here returns "403 Forbidden" instead of the file.
# =====================================================================

# Never show a list of files when a folder has no index page
Options -Indexes

# Hidden files and folders (.claude/, .agents/, .git/, .gitignore, ...)
# .well-known/ stays open because SSL certificates need it.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]
  # Photo consent proofs are private records (Saudi PDPL) — staff open them
  # only through admin_articles.php, never by a direct link
  RewriteRule ^uploads/consents/ - [F,L]
  # Nothing inside uploads/ may ever run as a script (owner, 13 Nov 2026).
  # Photos, videos and PDFs there still open normally; any file whose name
  # carries a script ending (also hidden inside, like x.php.jpg) answers 403
  RewriteRule ^uploads/.*\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|shtml)(\.|$) - [F,NC,L]
  # The old, unused app sources and database notes are never public
  RewriteRule ^(resha-app|supabase)(/|$) - [F,L]
  # The list of pages for search engines is made fresh by sitemap.php
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  # Certificate of Authenticity: the public verify page is oweili.com/verify
  # (the QR code opens /verify?no=OW-…). verify.php stays the email-confirm page.
  RewriteRule ^verify/?$ cert_verify.php [L,QSA]
  RewriteRule ^auctions/?$ auctions.php [L,QSA]
  # Art Map pages for Google (13 Nov 2026): /art-map/<region> and /art-map/<region>/<place>
  RewriteRule ^art-map/?$ art_map.php [L,QSA]
  RewriteRule ^art-map/([a-z]+)/?$ art_place.php?region=$1 [L,QSA]
  RewriteRule ^art-map/([a-z]+)/([a-z0-9-]+)/?$ art_place.php?region=$1&slug=$2 [L,QSA]
</IfModule>

# A friendly page in English and Arabic for any address that does not exist
ErrorDocument 404 /404.php

# Logs, backups and leftover copies of files (error_log, *.log, *.bak, *~ ...)
<FilesMatch "(?i)(^error_log$|\.(log|bak|old|orig|save|swp|tmp|gz|zip|tar)$|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Project notes, database setup files and the skills list
<FilesMatch "(?i)(\.md|\.sql|^skills-lock\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Pictures: CDNs and "mobile optimisation" must send them exactly as they are
# (no re-shrinking or format change for phones). Pages: never kept in the
# server's page cache, so phones always get the current page, never an old copy.
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(jpe?g|png|webp|gif|avif)$">
    Header set Cache-Control "public, max-age=31536000, no-transform"
  </FilesMatch>
  <FilesMatch "(?i)\.php$">
    Header set X-LiteSpeed-Cache-Control "no-cache"
    Header merge Cache-Control "no-transform"
  </FilesMatch>
</IfModule>

# Browser caching (4 Nov 2026): style files and scripts are always linked with a
# version number (owAsset(): ?v=<last change>), so the browser may keep them for a
# year; a changed file gets a new number and is loaded fresh. Fonts never change
# (a new font gets a new file name). Photos have random names, so they never change
# either. The homepage video has no number, so it is kept for 30 days.
<IfModule mod_headers.c>
  <FilesMatch "(?i)\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "(?i)\.mp4$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

# Text files are sent compressed (Hostinger's CDN already does this; this is the
# fallback for the server itself). Pictures, fonts and video are already compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# Hostinger's page cache (LiteSpeed) stays OFF for pages on purpose: every page
# carries a personal security token and the signed-in person's name, so a saved
# copy could show one visitor's page to another. Files above are cached instead.
